# 联系表单（Resend 邮件服务）—— 不配置时表单会降级为 mailto 引导
# 1. 到 https://resend.com 注册（免费 100 封/天）
# 2. 创建 API Key 填到下面
# 3. CONTACT_TO 填你的邮箱。注意：未验证域名时，Resend 只允许发给
#    注册 Resend 时使用的那个邮箱（个人站够用）；有了自己的域名后
#    在 src/app/api/contact/route.ts 里改 from 地址即可。
RESEND_API_KEY=
CONTACT_TO=you@example.com

# 留言板持久化（Upstash Redis）—— 不配置时自动回落内存模式（重启清空）
# 1. 到 https://upstash.com 注册（免费档：1 万次请求/天，个人站绰绰有余）
# 2. 创建一个 Redis 数据库（区域选离访客近的）
# 3. 在数据库页面复制 REST API 的 URL 和 TOKEN 填到下面，重启 dev server
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
